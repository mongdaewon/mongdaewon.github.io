{{/* 덱 페이지는 앱 마켓 catalog 에서 빌드 때 만든다(정본은 CDN 의 catalog.json, 레포에 복사하지 않는다).
     catalog 가 한국어뿐이라 ko 에만 만든다. 주소 /ko/apps/cantquit/decks/<id>/ 는 앱이 유니버설 링크로 받는다.
     catalog 를 못 받으면 빌드를 멈춘다 - 덱 페이지가 조용히 사라지는 것보다 낫다. */}}
{{ $url := "https://cdn.mongdaewon.com/cantquit/catalog.json" }}
{{ $data := dict }}
{{ with try (resources.GetRemote $url) }}
  {{ with .Err }}{{ errorf "catalog %s: %s" $url . }}
  {{ else with .Value }}{{ $data = . | transform.Unmarshal }}
  {{ else }}{{ errorf "catalog %s: empty" $url }}{{ end }}
{{ end }}
{{/* 표지 배추 포즈는 앱과 같게 고른다: 덱 id 글자 코드 합 % 4 (GalleryView.swift MarketCover.pose).
     Hugo 에 글자 코드 함수가 없어 id 에 쓰는 글자만 표로 둔다. 표에 없는 글자가 오면 빌드를 멈춘다. */}}
{{ $ord := `{"a":97,"b":98,"c":99,"d":100,"e":101,"f":102,"g":103,"h":104,"i":105,"j":106,"k":107,"l":108,"m":109,"n":110,"o":111,"p":112,"q":113,"r":114,"s":115,"t":116,"u":117,"v":118,"w":119,"x":120,"y":121,"z":122,"0":48,"1":49,"2":50,"3":51,"4":52,"5":53,"6":54,"7":55,"8":56,"9":57,"-":45,"_":95}` | transform.Unmarshal }}
{{ $poses := slice "card" "think" "cheer" "wow" }}
{{ range $i, $d := $data.decks }}
  {{ $cover := "" }}{{ with $d.cover }}{{ $cover = printf "https://cdn.mongdaewon.com/cantquit/%s" . }}{{ end }}
  {{ $sum := 0 }}
  {{ range split $d.id "" }}{{ $c := index $ord . }}{{ if not $c }}{{ errorf "deck id %s: 글자 %q 가 표에 없다" $d.id . }}{{ end }}{{ $sum = add $sum (int $c) }}{{ end }}
  {{ $.AddPage (dict
    "kind" "page"
    "type" "deck"
    "path" $d.id
    "title" $d.title
    "description" $d.description
    "weight" (add $i 1)
    "content" (dict "mediaType" "text/markdown" "value" $d.description)
    "params" (dict
      "deckId" $d.id
      "hook" $d.hook
      "category" $d.category
      "cardCount" $d.cardCount
      "plus" (gt ($d.cost | default 0) 0)
      "cover" $cover
      "keyphrase" $d.keyphrase
      "pose" (index $poses (mod $sum 4))
      "language" $d.language
      "size" $d.size
      "preview" ($d.preview | default slice)
      "images" $d.images
      "next" $d.next
      "gain" (index hugo.Data "cantquit-decks" $d.id)
      "smartBanner" true)
  ) }}
{{ end }}
